# ── Claude Code local settings ───────────────────────────────────────────
.claude/

# ── Machine-specific shell config (gitignored; sourced if present) ───────
scripts/sample_sbm.local.sh
scripts/sync_models.local.sh

# ── Python bytecode / caches ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class

# ── Virtual environments ─────────────────────────────────────────────────
env_SBM/
.venv/
venv/

# ── scikit-build-core / CMake / setuptools build artifacts ───────────────
build/
_skbuild/
dist/
*.egg-info/
pip-log.txt
pip-delete-this-directory.txt

# Compiled C++ extensions land next to the source after `pip install -e .`
src/SBM/**/*.so
src/SBM/**/*.dylib
src/SBM/**/*.pyd

# Run outputs ─────────────────────────────────────────────────────────────

# Models are never committed. They travel Mac <-> Midway via checksummed rsync
# (scripts/sync_models.sh; docs/MODEL_SYNC.md), not git. results/SHA256SUMS is
# the rsync integrity manifest and is covered by this ignore too.
results/
combine/
pruning/masks/
data/figs/

# ── Retired code + artifacts (kept on disk, out of git and out of rsync) ──
# Populated by the 2026-07 DCAlign retirement (see docs/two_model_progress.md);
# scripts/sync_models.sh also excludes it so a Midway pull never restores it.
.archive/

# ── DCAlign integration spike (cloned Julia pkg + scratch driver) ────────
dcalign_spike/

# ── Snakemake working metadata ───────────────────────────────────────────
.snakemake/

# ── Test / lint / type-check caches ──────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Jupyter ──────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── OS junk ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editors / IDEs ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# Scratch Notebook
scratch.ipynb
