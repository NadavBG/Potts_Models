# Two-model `combine` pipeline.
#
# SEPARATE from the single-model `Snakefile` (one MSA -> one model): this one
# takes two ALREADY-TRAINED models and scores a query set under both. Different
# DAG, config schema (combine_config.py vs workflow_config.py), and output tree
# (combine/ vs results/) — intentionally not merged. Scoring runs on the Mac;
# only `scoring.method: dcalign` needs Midway (the alignment is sharded there,
# then cached and pulled back). End-to-end runbook: docs/PIPELINE.md.
#
# One validated YAML config = one combine run. Consumes two already-trained
# models and scores a query set (each family's natural + synthetic sequences,
# or an external FASTA) under both, writing E_A / E_B / E_tot.
#
#   snakemake -s Snakefile.combine --configfile config/params_combine-CM-PPIC.yaml --cores 8 all
#
# Combine runs land under combine/<run_name>/ — a separate, .gitignored tree
# from the single-model results/, so dual-model runs never mix with single-model
# ones. The iteration helper
#   python scripts/iter.py run combine-CM-PPIC "<tag>" --snakefile Snakefile.combine
# mints combine/<run_name>/iter-NNN-<tag>/ and passes run_root in.
#
# Runs inside the project's uv venv (no `conda:` directive), like the main
# Snakefile; `threads`/`resources` declared on every rule for cluster use.

import sys

from SBM import combine_config as cc

# ── Config: validate, reject unknown keys ────────────────────────────────
if "run_name" not in config or "models" not in config:
    sys.exit(
        "ERROR: missing combine config. Invoke with a config file, e.g.\n"
        "  snakemake -s Snakefile.combine --configfile config/params_combine-CM-PPIC.yaml --cores 8 all"
    )

cfg = cc.from_dict({k: v for k, v in config.items() if k not in {"run_root"}})

RUN_NAME = cfg.run_name
RUN_ROOT = config.get("run_root") or f"combine/{RUN_NAME}"

# ── Path scheme (all rooted under RUN_ROOT) ──────────────────────────────
# Top-level holds the Mac↔Midway CONTRACT files (the cluster DCAlign scripts in
# pipeline/external/ read these exact paths) + the human note. Everything the
# pipeline produces on the Mac is grouped into two subdirs to keep the run dir
# tidy: data/ (tables) and provenance/ (manifests). figs/ holds figures.
CONFIG_SNAP    = f"{RUN_ROOT}/config_snapshot.yaml"   # contract (cluster reads it)
MODELS_JSON    = f"{RUN_ROOT}/models.json"            # contract (cluster reads it)
QUERY_FASTA    = f"{RUN_ROOT}/query/query.fasta"      # contract
QUERY_GROUPS   = f"{RUN_ROOT}/query/groups.json"      # contract
SCORES         = f"{RUN_ROOT}/data/scores.tsv"
SCORES_DETAIL  = f"{RUN_ROOT}/data/scores_detail.json"
ALIGNMENTS     = f"{RUN_ROOT}/data/alignments.txt"
SCORE_MANIFEST = f"{RUN_ROOT}/provenance/score_manifest.json"
ENERGY_FIG     = f"{RUN_ROOT}/figs/two_model_energy.pdf"
RUN_MANIFEST   = f"{RUN_ROOT}/provenance/run_manifest.json"

# potts_align cluster cache (only for method=potts_align). The Slurm gather writes
# <model>/alignments.tsv here out-of-process; the score rule reads it (an external
# DAG input, exactly like the dcalign cache) and recomputes energies in-frame.
POTTS_ALIGN_CACHE = f"{RUN_ROOT}/potts_align/cache"


def _score_potts_cache_inputs():
    """Declare the per-model potts_align cache as an input to `score` when that is
    the method, so Snakemake refuses to score until the cluster align+gather has
    filled the cache (makes the two-phase dependency explicit in the DAG)."""
    if cfg.scoring.method != "potts_align":
        return {}
    return {f"pa_cache_{i}": f"{POTTS_ALIGN_CACHE}/{m.name}/alignments.tsv"
            for i, m in enumerate(cfg.models)}

# DCAlign diagnostics (only meaningful for method=dcalign, which has a cache).
# Figures are gated on figures.enabled like the energy figure.
DCALIGN_BASELINE_TSV      = f"{RUN_ROOT}/data/dcalign_vs_inframe.tsv"
DCALIGN_BASELINE_JSON     = f"{RUN_ROOT}/data/dcalign_vs_inframe.json"
DCALIGN_BASELINE_MANIFEST = f"{RUN_ROOT}/provenance/dcalign_vs_inframe_manifest.json"
DCALIGN_BASELINE_FIG      = f"{RUN_ROOT}/figs/dcalign_vs_inframe.pdf"

DCALIGN_CONV_TSV      = f"{RUN_ROOT}/data/dcalign_convergence.tsv"
DCALIGN_CONV_JSON     = f"{RUN_ROOT}/data/dcalign_convergence.json"
DCALIGN_CONV_MANIFEST = f"{RUN_ROOT}/provenance/dcalign_convergence_manifest.json"
DCALIGN_CONV_FIG      = f"{RUN_ROOT}/figs/dcalign_convergence.pdf"

DCALIGN_BASELINE_OUTPUTS = []
if cfg.scoring.method == "dcalign":
    DCALIGN_BASELINE_OUTPUTS = [
        DCALIGN_BASELINE_TSV, DCALIGN_BASELINE_JSON, DCALIGN_BASELINE_MANIFEST,
        DCALIGN_CONV_TSV, DCALIGN_CONV_JSON, DCALIGN_CONV_MANIFEST,
    ]
    if cfg.figures.enabled:
        DCALIGN_BASELINE_OUTPUTS += [DCALIGN_BASELINE_FIG, DCALIGN_CONV_FIG]


# ── Aggregate target ──────────────────────────────────────────────────────
rule all:
    default_target: True
    input:
        CONFIG_SNAP,
        MODELS_JSON,
        QUERY_FASTA,
        SCORES,
        *([ENERGY_FIG] if cfg.figures.enabled else []),
        *DCALIGN_BASELINE_OUTPUTS,
        RUN_MANIFEST,


# ── Provenance: freeze the validated config into the run dir ─────────────
rule snapshot_config:
    output:
        CONFIG_SNAP,
    log:
        f"{RUN_ROOT}/logs/snapshot_config.log"
    threads: 1
    resources:
        mem_mb=256,
        runtime=2,
    script:
        "scripts/wf/run_snapshot_config_combine.py"


# ── Resolve the two referenced models (paths, hashes, L, seed MSAs) ──────
rule resolve_models:
    output:
        MODELS_JSON,
    log:
        f"{RUN_ROOT}/logs/resolve_models.log"
    threads: 1
    resources:
        mem_mb=2000,
        runtime=10,
    script:
        "scripts/wf/run_resolve_models.py"


# ── Assemble the query set into a (mixed-length) FASTA + groups sidecar ──
rule build_query:
    input:
        models=MODELS_JSON,
    output:
        fasta=QUERY_FASTA,
        groups=QUERY_GROUPS,
    log:
        f"{RUN_ROOT}/logs/build_query.log"
    threads: 1
    resources:
        mem_mb=4000,
        runtime=20,
    script:
        "scripts/wf/run_build_query.py"


# ── Score every query sequence under both models ─────────────────────────
rule score:
    input:
        models=MODELS_JSON,
        fasta=QUERY_FASTA,
        groups=QUERY_GROUPS,
        **_score_potts_cache_inputs(),
    output:
        scores=SCORES,
        detail=SCORES_DETAIL,
        alignments=ALIGNMENTS,
        manifest=SCORE_MANIFEST,
    params:
        run_root=RUN_ROOT,
    log:
        f"{RUN_ROOT}/logs/score.log"
    threads: 4
    resources:
        mem_mb=8000,
        runtime=240,
    script:
        "scripts/wf/run_score.py"


# ── Consolidated energy figure (only when enabled) ───────────────────────
if cfg.figures.enabled:

    rule render_combine:
        input:
            scores=SCORES,
            models=MODELS_JSON,
        output:
            ENERGY_FIG,
        log:
            f"{RUN_ROOT}/logs/render_combine.log"
        threads: 1
        resources:
            mem_mb=4000,
            runtime=30,
        script:
            "scripts/wf/run_render_combine.py"


# ── DCAlign-vs-in-frame baseline (only when method=dcalign) ──────────────
if cfg.scoring.method == "dcalign":

    rule dcalign_baseline:
        input:
            models=MODELS_JSON,
            fasta=QUERY_FASTA,
            groups=QUERY_GROUPS,
            scores=SCORES,  # orders after scoring; the cache must be present by then
        output:
            tsv=DCALIGN_BASELINE_TSV,
            summary=DCALIGN_BASELINE_JSON,
            manifest=DCALIGN_BASELINE_MANIFEST,
            **({"fig": DCALIGN_BASELINE_FIG} if cfg.figures.enabled else {}),
        params:
            run_root=RUN_ROOT,
        log:
            f"{RUN_ROOT}/logs/dcalign_baseline.log"
        threads: 1
        resources:
            mem_mb=4000,
            runtime=20,
        script:
            "scripts/wf/run_dcalign_baseline.py"

    rule dcalign_convergence:
        input:
            models=MODELS_JSON,
            groups=QUERY_GROUPS,
            scores=SCORES,  # orders after scoring; the cache must be present by then
        output:
            tsv=DCALIGN_CONV_TSV,
            summary=DCALIGN_CONV_JSON,
            manifest=DCALIGN_CONV_MANIFEST,
            **({"fig": DCALIGN_CONV_FIG} if cfg.figures.enabled else {}),
        params:
            run_root=RUN_ROOT,
        log:
            f"{RUN_ROOT}/logs/dcalign_convergence.log"
        threads: 1
        resources:
            mem_mb=2000,
            runtime=15,
        script:
            "scripts/wf/run_dcalign_convergence.py"


# ── Aggregate run manifest (last) ────────────────────────────────────────
rule run_manifest:
    input:
        CONFIG_SNAP,
        MODELS_JSON,
        SCORES,
        *([ENERGY_FIG] if cfg.figures.enabled else []),
        *DCALIGN_BASELINE_OUTPUTS,
    output:
        RUN_MANIFEST,
    params:
        run_root=RUN_ROOT,
    log:
        f"{RUN_ROOT}/logs/run_manifest.log"
    threads: 1
    resources:
        mem_mb=512,
        runtime=10,
    script:
        "scripts/wf/run_combine_manifest.py"
