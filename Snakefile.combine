# Two-model `combine` pipeline.
#
# SEPARATE from the single-model `Snakefile` (one MSA -> one model): this one
# takes two ALREADY-TRAINED models and scores a query set under both. Different
# DAG, config schema (combine_config.py vs workflow_config.py), and output tree
# (combine/ vs results/) — intentionally not merged. Scoring runs on the Mac.
# `scoring.method: potts_align` (the production couplings-aware aligner;
# docs/POTTS_ALIGN.md) can pre-build its alignment cache out-of-process on a
# Slurm array for large query sets, then score locally.
#
# One validated YAML config = one combine run. Consumes two already-trained
# models and scores a query set (each family's natural + synthetic sequences,
# or an external FASTA) under both, writing E_A / E_B / E_tot.
#
#   snakemake -s Snakefile.combine --configfile config/params_combine-CM-PPIC.yaml --cores 8 all
#
# Combine runs land under combine/<run_name>/ — a separate, .gitignored tree
# from the single-model results/, so dual-model runs never mix with single-model
# ones. The iteration helper
#   python scripts/iter.py run combine-CM-PPIC "<tag>" --snakefile Snakefile.combine
# mints combine/<run_name>/iter-NNN-<tag>/ and passes run_root in.
#
# Runs inside the project's uv venv (no `conda:` directive), like the main
# Snakefile; `threads`/`resources` declared on every rule for cluster use.

import os
import sys

from SBM import combine_config as cc

# ── Config: validate, reject unknown keys ────────────────────────────────
if "run_name" not in config or "models" not in config:
    sys.exit(
        "ERROR: missing combine config. Invoke with a config file, e.g.\n"
        "  snakemake -s Snakefile.combine --configfile config/params_combine-CM-PPIC.yaml --cores 8 all"
    )

cfg = cc.from_dict({k: v for k, v in config.items() if k not in {"run_root"}})

RUN_NAME = cfg.run_name
RUN_ROOT = config.get("run_root") or f"combine/{RUN_NAME}"

# ── Path scheme (all rooted under RUN_ROOT) ──────────────────────────────
# Top-level holds the Mac↔Midway CONTRACT files (the cluster DCAlign scripts in
# pipeline/external/ read these exact paths) + the human note. Everything the
# pipeline produces on the Mac is grouped into two subdirs to keep the run dir
# tidy: data/ (tables) and provenance/ (manifests). figs/ holds figures.
CONFIG_SNAP    = f"{RUN_ROOT}/config_snapshot.yaml"   # contract (cluster reads it)
MODELS_JSON    = f"{RUN_ROOT}/models.json"            # contract (cluster reads it)
QUERY_FASTA    = f"{RUN_ROOT}/query/query.fasta"      # contract
QUERY_GROUPS   = f"{RUN_ROOT}/query/groups.json"      # contract
SCORES         = f"{RUN_ROOT}/data/scores.tsv"
SCORES_DETAIL  = f"{RUN_ROOT}/data/scores_detail.json"
ALIGNMENTS     = f"{RUN_ROOT}/data/alignments.txt"
SCORE_MANIFEST = f"{RUN_ROOT}/provenance/score_manifest.json"
ENERGY_FIG     = f"{RUN_ROOT}/figs/two_model_energy.pdf"
RUN_MANIFEST   = f"{RUN_ROOT}/provenance/run_manifest.json"

# The config the user invokes Snakemake with (becomes $CFG in RUNBOOK.txt); falls
# back to the in-run snapshot if invoked without a --configfile (never, in practice).
# Snakemake resolves configfiles to absolute paths; relativize to the repo cwd so
# the runbook shows `config/params_…yaml` (matching what new_combine.py writes).
_CONFIGFILES = list(getattr(workflow, "configfiles", []) or [])
if _CONFIGFILES:
    try:
        CONFIG_PATH = os.path.relpath(str(_CONFIGFILES[0]))
    except ValueError:
        CONFIG_PATH = str(_CONFIGFILES[0])
else:
    CONFIG_PATH = CONFIG_SNAP
# Per-run, copy-pasteable runbook (score -> design -> characterize). Regenerated on
# every `all` from the validated config so it can never drift (SBM.combine_runbook).
RUNBOOK_TXT    = f"{RUN_ROOT}/RUNBOOK.txt"

# E_tot combining weights, derived post-hoc from the naturals (compute_weights
# rule): the weights equalize each family's median native energy so E_tot is not
# biased toward one family. JSON = the calculation; sweep TSV backs the figure.
WEIGHTS_JSON   = f"{RUN_ROOT}/data/energy_weights.json"
WEIGHTS_SWEEP  = f"{RUN_ROOT}/data/energy_weight_sweep.tsv"
WEIGHTS_FIG    = f"{RUN_ROOT}/figs/energy_weights.pdf"

WEIGHTS_OUTPUTS = [WEIGHTS_JSON, WEIGHTS_SWEEP] + (
    [WEIGHTS_FIG] if cfg.figures.enabled else []
)

# potts_align cluster cache (only for method=potts_align). The Slurm gather writes
# <model>/alignments.tsv here out-of-process; the score rule reads it (an external
# DAG input, exactly like the dcalign cache) and recomputes energies in-frame.
POTTS_ALIGN_CACHE = f"{RUN_ROOT}/potts_align/cache"


def _score_potts_cache_inputs():
    """Declare the per-model potts_align cache as an input to `score` when that is
    the method, so Snakemake refuses to score until the cluster align+gather has
    filled the cache (makes the two-phase dependency explicit in the DAG)."""
    if cfg.scoring.method != "potts_align":
        return {}
    return {f"pa_cache_{i}": f"{POTTS_ALIGN_CACHE}/{m.name}/alignments.tsv"
            for i, m in enumerate(cfg.models)}

# potts_align ground-state-recovery baseline (only when method=potts_align, which
# has a cluster cache). The potts_align analogue of the dcalign baseline: per
# home pair, potts_align's minimum energy vs the native in-frame energy. A native
# gap placement is itself a frame the minimizer searches, so ΔE<=0 is expected —
# the figure reads out how often the native frame already IS the ground state.
POTTS_BASELINE_TSV      = f"{RUN_ROOT}/data/potts_align_vs_inframe.tsv"
POTTS_BASELINE_JSON     = f"{RUN_ROOT}/data/potts_align_vs_inframe.json"
POTTS_BASELINE_MANIFEST = f"{RUN_ROOT}/provenance/potts_align_vs_inframe_manifest.json"
POTTS_BASELINE_FIG      = f"{RUN_ROOT}/figs/potts_align_vs_inframe.pdf"

POTTS_BASELINE_OUTPUTS = []
if cfg.scoring.method == "potts_align":
    POTTS_BASELINE_OUTPUTS = [
        POTTS_BASELINE_TSV, POTTS_BASELINE_JSON, POTTS_BASELINE_MANIFEST,
    ]
    if cfg.figures.enabled:
        POTTS_BASELINE_OUTPUTS += [POTTS_BASELINE_FIG]


# ── Two-model design stage (joint annealing over E_tot; docs/DESIGN_TWO_MODEL.md) ──
# Off unless design.enabled. Seeds trajectories from random + CM/PPIC naturals and
# minimizes E_tot = w_A·E_A + w_B·E_B. The anneal is cheap (~9 µs/step); the final
# warm-started potts_align polish is the variable cost. design.execution picks where
# the anneal runs — LOCAL (Mac) or CLUSTER (emit config + hand-off, run the array on
# Midway, pull back). "auto" predicts the local wall-time and runs local iff it is
# within design.local_budget_minutes.
DESIGN_DIR       = f"{RUN_ROOT}/design"
DESIGN_CONFIG    = f"{DESIGN_DIR}/design_config.json"
DESIGN_TRAJ      = f"{DESIGN_DIR}/trajectories.npz"
DESIGN_TSV       = f"{DESIGN_DIR}/designed.tsv"
DESIGN_FASTA     = f"{DESIGN_DIR}/designed_sequences.fasta"
DESIGN_MANIFEST  = f"{DESIGN_DIR}/design_manifest.json"
DESIGN_ALN_A     = f"{DESIGN_DIR}/design_aln_A.fasta"   # designs in model-A frame (uploadable)
DESIGN_ALN_B     = f"{DESIGN_DIR}/design_aln_B.fasta"   # designs in model-B frame
DESIGN_HANDOFF   = f"{DESIGN_DIR}/MIDWAY_HANDOFF.txt"
DESIGN_TRAJ_FIG  = f"{RUN_ROOT}/figs/design_trajectories.pdf"
DESIGN_PHASE_FIG = f"{RUN_ROOT}/figs/design_phase_space.pdf"
DESIGN_LEN_FIG   = f"{RUN_ROOT}/figs/design_lengths.pdf"
DESIGN_ALN_FIG   = f"{RUN_ROOT}/figs/design_alignment.pdf"

# Cost model: per-step ~15 µs (measured on the CM/PPIC models, 8 cores); per-chain
# warm-started polish upper bounds by schedule (measured, conservative — high-gap CM
# frame). Bounds the execution: auto local-vs-cluster gate.
_DESIGN_PER_STEP_S = 1.5e-5
_DESIGN_POLISH_S = {"auto": 220.0, "fast": 6.0, "default": 220.0, "thorough": 440.0}


def _design_runs_local():
    """True to run the anneal on the Mac, False to emit the cluster config + hand-off.

    ``execution: local``/``cluster`` force it; ``auto`` compares a predicted local
    wall-time (anneal + polish, over ``workflow.cores``) to ``local_budget_minutes``."""
    d = cfg.design
    if d.execution == "local":
        return True
    if d.execution == "cluster":
        return False
    cores = max(1, int(getattr(workflow, "cores", 1) or 1))
    anneal_s = d.n_chains * d.steps * _DESIGN_PER_STEP_S
    polish_s = d.n_chains * (_DESIGN_POLISH_S[d.polish_schedule] if d.polish else 0.0)
    est_min = (anneal_s + polish_s) / cores / 60.0
    verdict = "LOCAL" if est_min <= d.local_budget_minutes else "CLUSTER"
    print(f"[design] estimated {est_min:.1f} min on {cores} cores "
          f"(n_chains={d.n_chains}, steps={d.steps}, "
          f"polish={d.polish_schedule if d.polish else 'off'}); "
          f"budget {d.local_budget_minutes} min -> {verdict}", file=sys.stderr)
    return est_min <= d.local_budget_minutes


DESIGN_OUTPUTS = []
_DESIGN_LOCAL = False
if cfg.design.enabled:
    _DESIGN_LOCAL = _design_runs_local()
    if _DESIGN_LOCAL:
        DESIGN_OUTPUTS = [DESIGN_TRAJ, DESIGN_TSV, DESIGN_FASTA, DESIGN_MANIFEST,
                          DESIGN_ALN_A, DESIGN_ALN_B]
        if cfg.figures.enabled:
            DESIGN_OUTPUTS += [DESIGN_TRAJ_FIG, DESIGN_PHASE_FIG, DESIGN_LEN_FIG, DESIGN_ALN_FIG]
    else:
        DESIGN_OUTPUTS = [DESIGN_CONFIG, DESIGN_HANDOFF]


# ── Characterization render stage (fold + BLAST; docs/CHARACTERIZE.md) ────
# Off unless characterize.enabled. The heavy compute (ESMFold + TM-align + BLAST +
# merge) runs on Midway and lands the tidy tables under characterize/data/; this
# stage only RENDERS the Mac-authoritative figures + stats from summary.tsv (pure
# numpy/matplotlib). Its input is Midway-produced and pulled via sync_models.sh, so
# no Mac rule "produces" it. Like design_render in cluster mode, the figs are only
# folded into `rule all` once the table is on disk (checked at DAG build) — so `all`
# isn't blocked on Midway data that hasn't been pulled. The rule is defined whenever
# characterize.enabled, so once pulled you either re-run `all` or target a fig
# explicitly (`snakemake ... <run_root>/figs/characterization_overview.pdf`), which
# fails loudly if summary.tsv is still missing. natural_summary.tsv is optional (the
# wrapper overlays it only when present).
CHAR_DIR          = f"{RUN_ROOT}/characterize"
CHAR_SUMMARY      = f"{CHAR_DIR}/data/summary.tsv"
CHAR_NAT_SUMMARY  = f"{CHAR_DIR}/data/natural_summary.tsv"
CHAR_STATS_TSV    = f"{CHAR_DIR}/data/characterization_stats.tsv"
CHAR_OVERVIEW_FIG = f"{RUN_ROOT}/figs/characterization_overview.pdf"
CHAR_TM_FIG       = f"{RUN_ROOT}/figs/tm_A_vs_B.pdf"
CHAR_FOLDCALL_FIG = f"{RUN_ROOT}/figs/fold_call_breakdown.pdf"

CHARACTERIZE_OUTPUTS = []
if cfg.characterize.enabled and cfg.figures.enabled:
    if os.path.exists(CHAR_SUMMARY):
        CHARACTERIZE_OUTPUTS = [CHAR_OVERVIEW_FIG, CHAR_TM_FIG, CHAR_FOLDCALL_FIG, CHAR_STATS_TSV]
    else:
        print(f"[characterize] {CHAR_SUMMARY} not found — skipping from `all` "
              f"(pull it from Midway, then re-run or target a fig explicitly)",
              file=sys.stderr)


# ── Aggregate target ──────────────────────────────────────────────────────
rule all:
    default_target: True
    input:
        CONFIG_SNAP,
        RUNBOOK_TXT,
        MODELS_JSON,
        QUERY_FASTA,
        SCORES,
        *WEIGHTS_OUTPUTS,
        *([ENERGY_FIG] if cfg.figures.enabled else []),
        *POTTS_BASELINE_OUTPUTS,
        *DESIGN_OUTPUTS,
        *CHARACTERIZE_OUTPUTS,
        RUN_MANIFEST,


# ── Provenance: freeze the validated config into the run dir ─────────────
rule snapshot_config:
    output:
        CONFIG_SNAP,
    log:
        f"{RUN_ROOT}/logs/snapshot_config.log"
    threads: 1
    resources:
        mem_mb=256,
        runtime=2,
    script:
        "scripts/wf/run_snapshot_config_combine.py"


# ── Per-run copy-pasteable runbook (regenerated from the config each `all`) ──
# Dependency-free, cheap. The `fingerprint` param carries the full validated
# config so Snakemake's params rerun-trigger regenerates RUNBOOK.txt whenever the
# config changes for the same run_root — it can never go stale.
rule runbook:
    output:
        RUNBOOK_TXT,
    params:
        run_root=RUN_ROOT,
        config_path=CONFIG_PATH,
        fingerprint=repr(cfg.as_dict()),
    log:
        f"{RUN_ROOT}/logs/runbook.log"
    threads: 1
    resources:
        mem_mb=256,
        runtime=2,
    script:
        "scripts/wf/run_runbook.py"


# ── Resolve the two referenced models (paths, hashes, L, seed MSAs) ──────
rule resolve_models:
    output:
        MODELS_JSON,
    log:
        f"{RUN_ROOT}/logs/resolve_models.log"
    threads: 1
    resources:
        mem_mb=2000,
        runtime=10,
    script:
        "scripts/wf/run_resolve_models.py"


# ── Assemble the query set into a (mixed-length) FASTA + groups sidecar ──
rule build_query:
    input:
        models=MODELS_JSON,
    output:
        fasta=QUERY_FASTA,
        groups=QUERY_GROUPS,
    log:
        f"{RUN_ROOT}/logs/build_query.log"
    threads: 1
    resources:
        mem_mb=4000,
        runtime=20,
    script:
        "scripts/wf/run_build_query.py"


# ── Score every query sequence under both models ─────────────────────────
rule score:
    input:
        models=MODELS_JSON,
        fasta=QUERY_FASTA,
        groups=QUERY_GROUPS,
        **_score_potts_cache_inputs(),
    output:
        scores=SCORES,
        detail=SCORES_DETAIL,
        alignments=ALIGNMENTS,
        manifest=SCORE_MANIFEST,
    params:
        run_root=RUN_ROOT,
    log:
        f"{RUN_ROOT}/logs/score.log"
    threads: 4
    resources:
        mem_mb=8000,
        runtime=240,
    script:
        "scripts/wf/run_score.py"


# ── Consolidated energy figure (only when enabled) ───────────────────────
if cfg.figures.enabled:

    rule render_combine:
        input:
            scores=SCORES,
            models=MODELS_JSON,
        output:
            ENERGY_FIG,
        log:
            f"{RUN_ROOT}/logs/render_combine.log"
        threads: 1
        resources:
            mem_mb=4000,
            runtime=30,
        script:
            "scripts/wf/run_render_combine.py"


# ── E_tot combining weights, derived from the naturals (method-agnostic) ──
rule compute_weights:
    input:
        scores=SCORES,
        models=MODELS_JSON,
    output:
        weights=WEIGHTS_JSON,
        sweep=WEIGHTS_SWEEP,
        **({"fig": WEIGHTS_FIG} if cfg.figures.enabled else {}),
    log:
        f"{RUN_ROOT}/logs/compute_weights.log"
    threads: 1
    resources:
        mem_mb=4000,
        runtime=15,
    script:
        "scripts/wf/run_compute_weights.py"


# ── Two-model design: resolve the run spec, then run locally OR emit a hand-off ──
if cfg.design.enabled:

    rule design_config:
        input:
            models=MODELS_JSON,
            weights=WEIGHTS_JSON,
        output:
            DESIGN_CONFIG,
        params:
            run_root=RUN_ROOT,
        log:
            f"{RUN_ROOT}/logs/design_config.log"
        threads: 1
        resources:
            mem_mb=2000,
            runtime=15,
        script:
            "scripts/wf/run_design_config.py"

    if _DESIGN_LOCAL:

        rule design_local:
            input:
                config=DESIGN_CONFIG,
            output:
                traj=DESIGN_TRAJ,
                tsv=DESIGN_TSV,
                fasta=DESIGN_FASTA,
                manifest=DESIGN_MANIFEST,
                aln_a=DESIGN_ALN_A,
                aln_b=DESIGN_ALN_B,
            log:
                f"{RUN_ROOT}/logs/design_local.log"
            threads: workflow.cores
            resources:
                mem_mb=8000,
                runtime=720,
            script:
                "scripts/wf/run_design_local.py"

    else:

        rule design_handoff:
            input:
                config=DESIGN_CONFIG,
            output:
                DESIGN_HANDOFF,
            params:
                run_root=RUN_ROOT,
                config_path=CONFIG_PATH,
            log:
                f"{RUN_ROOT}/logs/design_handoff.log"
            threads: 1
            resources:
                mem_mb=256,
                runtime=2,
            script:
                "scripts/wf/run_design_handoff.py"

    # Render is defined in BOTH modes: locally it's part of the run; for a cluster run
    # it renders once trajectories.npz has been pulled back (target the figs explicitly,
    # e.g. `snakemake ... <run_root>/figs/design_alignment.pdf`). Its inputs come from
    # design_local (local) or the synced gather (cluster) — Snakemake needs no rule to
    # "produce" them in cluster mode, they are already on disk.
    if cfg.figures.enabled:

        rule design_render:
            input:
                traj=DESIGN_TRAJ,
                manifest=DESIGN_MANIFEST,
                scores=SCORES,
                aln_a=DESIGN_ALN_A,
                aln_b=DESIGN_ALN_B,
            output:
                DESIGN_TRAJ_FIG,
                DESIGN_PHASE_FIG,
                DESIGN_LEN_FIG,
                DESIGN_ALN_FIG,
            params:
                run_root=RUN_ROOT,
            log:
                f"{RUN_ROOT}/logs/design_render.log"
            threads: 1
            resources:
                mem_mb=4000,
                runtime=30,
            script:
                "scripts/wf/run_render_design.py"


# ── Characterization figures (Mac-render of Midway's summary.tsv) ─────────
if cfg.characterize.enabled and cfg.figures.enabled:

    rule characterize_render:
        input:
            summary=CHAR_SUMMARY,
            # natural_summary.tsv is optional (controls); declare it as a tracked input
            # only when it is already on disk, so a re-pulled controls table triggers a
            # re-render — but its absence never blocks the rule. The wrapper resolves it
            # from disk regardless.
            **({"natural": CHAR_NAT_SUMMARY} if os.path.exists(CHAR_NAT_SUMMARY) else {}),
        output:
            CHAR_OVERVIEW_FIG,
            CHAR_TM_FIG,
            CHAR_FOLDCALL_FIG,
            CHAR_STATS_TSV,
        params:
            run_root=RUN_ROOT,
        log:
            f"{RUN_ROOT}/logs/characterize_render.log"
        threads: 1
        resources:
            mem_mb=4000,
            runtime=30,
        script:
            "scripts/wf/run_render_characterize.py"


# ── potts_align ground-state-recovery baseline (only when method=potts_align) ──
if cfg.scoring.method == "potts_align":

    rule potts_align_baseline:
        input:
            models=MODELS_JSON,
            fasta=QUERY_FASTA,
            groups=QUERY_GROUPS,
            scores=SCORES,  # orders after scoring; the cache must be present by then
        output:
            tsv=POTTS_BASELINE_TSV,
            summary=POTTS_BASELINE_JSON,
            manifest=POTTS_BASELINE_MANIFEST,
            **({"fig": POTTS_BASELINE_FIG} if cfg.figures.enabled else {}),
        params:
            run_root=RUN_ROOT,
        log:
            f"{RUN_ROOT}/logs/potts_align_baseline.log"
        threads: 1
        resources:
            mem_mb=4000,
            runtime=30,
        script:
            "scripts/wf/run_potts_align_baseline.py"


# ── Aggregate run manifest (last) ────────────────────────────────────────
rule run_manifest:
    input:
        CONFIG_SNAP,
        MODELS_JSON,
        SCORES,
        *WEIGHTS_OUTPUTS,
        *([ENERGY_FIG] if cfg.figures.enabled else []),
        *POTTS_BASELINE_OUTPUTS,
        *DESIGN_OUTPUTS,
        *CHARACTERIZE_OUTPUTS,
    output:
        RUN_MANIFEST,
    params:
        run_root=RUN_ROOT,
    log:
        f"{RUN_ROOT}/logs/run_manifest.log"
    threads: 1
    resources:
        mem_mb=512,
        runtime=10,
    script:
        "scripts/wf/run_combine_manifest.py"
